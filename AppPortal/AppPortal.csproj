<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <Target Name="TailwindBuild" BeforeTargets="Build">
    <Exec Command="npx tailwindcss -i Styles/app.css -o wwwroot/css/app.css --minify" Condition="'$(Configuration)'=='Release' And !Exists('wwwroot/css/app.css')" />
    <Exec Command="npx tailwindcss -i Styles/app.css -o wwwroot/css/app.css" Condition="'$(Configuration)'!='Release' And !Exists('wwwroot/css/app.css')" />
  </Target>

</Project>
