@page
@model AppPortal.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "管理后台";
}

<div class="page-shell">
    <div class="mb-7 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
            <h1 class="page-title">应用管理</h1>
            <p class="page-desc">维护应用列表，管理启用/禁用状态</p>
        </div>
        <div class="toolbar">
            <a class="btn-secondary btn-sm" asp-page="Hosts"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-server"></use></svg>Host 目录</a>
            <a class="btn-secondary btn-sm" asp-page="Sources"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plug"></use></svg>数据源 / 导入</a>
            <a class="btn-primary btn-sm" asp-page="Create">
                <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
                新增应用
            </a>
        </div>
    </div>

    @if (TempData["Error"] is string errorMsg)
    {
        <div class="alert-error">@errorMsg</div>
    }

    @if (Model.Apps.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><svg class="icon icon-xl" aria-hidden="true"><use href="#i-package"></use></svg></div>
            <p class="empty-title">暂无应用</p>
            <p class="empty-desc">点击「新增应用」开始添加</p>
        </div>
    }
    else
    {
        <div class="table-panel"><div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-name">名称</th>
                        <th class="col-nowrap">模块</th>
                        <th class="col-nowrap">来源</th>
                        <th class="col-nowrap col-num">排序</th>
                        <th class="col-nowrap">状态</th>
                        <th class="col-actions">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Apps)
                    {
                        <tr>
                            <td class="col-name">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(app.IconUrl))
                                    {
                                        <div class="w-9 h-9 rounded-lg overflow-hidden bg-gray-50 dark:bg-gray-800 flex items-center justify-center">
                                            <img src="@app.IconUrl" alt="" class="w-7 h-7 object-contain" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="app-avatar-sm">@app.Name[..1]</div>
                                    }
                                    <div class="min-w-0">
                                        <div class="font-medium text-gray-900 dark:text-gray-100 truncate max-w-[220px]">@app.Name</div>
                                        @if (!string.IsNullOrEmpty(app.Description))
                                        {
                                            <div class="text-xs text-gray-400 dark:text-gray-500 truncate max-w-[220px]">@app.Description</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="col-nowrap">@app.Modules.Count 个</td>
                            <td class="col-nowrap">
                                @if (app.SourceId is null)
                                {
                                    <span class="badge-muted">手工</span>
                                }
                                else
                                {
                                    <span class="badge-info">导入</span>
                                }
                            </td>
                            <td class="col-num">@app.SortOrder</td>
                            <td class="col-nowrap">
                                @if (app.IsEnabled)
                                {
                                    <span class="badge-success"><span class="badge-dot"></span>启用</span>
                                }
                                else
                                {
                                    <span class="badge-muted"><span class="badge-dot"></span>禁用</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@app.Id" class="inline">
                                        <button type="submit" class="btn-secondary btn-sm">@(app.IsEnabled ? "禁用" : "启用")</button>
                                    </form>
                                    <div class="row-actions-overflow">
                                        <button type="button"
                                                class="btn-secondary btn-sm btn-overflow-toggle"
                                                aria-expanded="false"
                                                aria-label="更多操作">
                                            <svg class="icon icon-sm" aria-hidden="true"><use href="#i-more"></use></svg>
                                        </button>
                                        <div class="row-actions-menu">
                                            <a class="btn-secondary btn-sm" asp-page="Edit" asp-route-id="@app.Id"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-pencil"></use></svg>编辑</a>
                                            <a class="btn-danger btn-sm" asp-page="Delete" asp-route-id="@app.Id">删除</a>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            // 移动端操作列下拉菜单
            document.querySelectorAll('.btn-overflow-toggle').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    var menu = btn.parentElement.querySelector('.row-actions-menu');
                    if (!menu) return;
                    var isOpen = menu.classList.toggle('open');
                    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    document.querySelectorAll('.row-actions-menu.open').forEach(function (m) {
                        if (m !== menu) {
                            m.classList.remove('open');
                            var otherBtn = m.parentElement.querySelector('.btn-overflow-toggle');
                            if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                        }
                    });
                });
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.row-actions-overflow')) {
                    document.querySelectorAll('.row-actions-menu.open').forEach(function (m) {
                        m.classList.remove('open');
                        var btn = m.parentElement.querySelector('.btn-overflow-toggle');
                        if (btn) btn.setAttribute('aria-expanded', 'false');
                    });
                }
            });
        })();
    </script>
}
