@page
@model AppPortal.Pages.Admin.HostsModel
@{
    ViewData["Title"] = "Host 管理";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Index">
        <svg class="icon"><use href="#i-arrow-left"></use></svg>
        返回管理列表
    </a>

    <div class="mb-7">
        <h1 class="page-title">Host 目录</h1>
        <p class="page-desc">一个 Host 可包含多个 IP/地址，供模块地址选用</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-warn">@Model.Message</div>
    }

    <div class="table-panel mb-6">
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-name">名称</th>
                        <th>地址</th>
                        <th class="col-nowrap">默认</th>
                        <th class="col-actions">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.Hosts)
                    {
                        <tr>
                            <td class="col-name">@h.Name</td>
                            <td>
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var addr in h.Addresses)
                                    {
                                        <span class="badge-muted mono">@addr</span>
                                    }
                                    @if (h.Addresses.Count == 0)
                                    {
                                        <span class="text-gray-400 text-xs">无地址</span>
                                    }
                                </div>
                            </td>
                            <td class="col-nowrap">
                                @if (h.IsDefault)
                                {
                                    <span class="badge-info">默认</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@h.Id" class="inline">
                                        <button type="submit" class="btn-danger btn-sm">
                                            <svg class="icon icon-sm"><use href="#i-trash"></use></svg>删除
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Hosts.Count == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="4">暂无 Host，请在下方添加</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card card-pad">
        <h2 class="section-title mb-4">新增 Host</h2>
        <form method="post" asp-page-handler="Create" class="space-y-4">
            <div>
                <label class="field-label">名称 *</label>
                <input asp-for="NewName" class="input" placeholder="办公网 / 公网 / 运维网" />
            </div>
            <div>
                <label class="field-label">IP / 地址 *</label>
                <textarea asp-for="NewAddresses" class="textarea" rows="3" placeholder="10.0.0.5&#10;10.0.0.6&#10;portal.example.com"></textarea>
                <p class="field-hint">一行一个地址，也可用逗号分隔；同一 Host 下可挂多个 IP</p>
            </div>
            <button type="submit" class="btn-primary">
                <svg class="icon"><use href="#i-plus"></use></svg>添加
            </button>
        </form>
    </div>
</div>
