@page
@model AppPortal.Pages.Admin.HostsModel
@{
    ViewData["Title"] = "Host 管理";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Index">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
        返回管理列表
    </a>

    <div class="mb-7">
        <h1 class="page-title">Host 目录</h1>
        <p class="page-desc">全局可访问主机，应用可引用；详情页按 Host 解析入口地址</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-warn">@Model.Message</div>
    }

    <div class="table-panel mb-6"><div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>名称</th>
                    <th>地址</th>
                    <th>默认</th>
                    <th class="!text-right">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var h in Model.Hosts)
                {
                    <tr>
                        <td class="!font-medium !text-gray-900">@h.Name</td>
                        <td class="mono !text-gray-600">@h.Address</td>
                        <td>
                            @if (h.IsDefault)
                            {
                                <span class="badge-info">默认</span>
                            }
                        </td>
                        <td>
                            <div class="toolbar justify-end">
                                <form method="post" asp-page-handler="Delete" asp-route-id="@h.Id" class="inline">
                                    <button type="submit" class="btn-danger btn-sm"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"></use></svg>删除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Hosts.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="!py-12 text-center text-gray-400">暂无 Host，请在下方添加</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <div class="card card-pad">
        <h2 class="section-title mb-4">新增 Host</h2>
        <form method="post" asp-page-handler="Create" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="field-label">名称 *</label>
                <input asp-for="NewHost.Name" class="input" placeholder="办公网" />
            </div>
            <div>
                <label class="field-label">地址 *</label>
                <input asp-for="NewHost.Address" class="input" placeholder="10.0.0.5 或 portal.example.com" />
            </div>
            <div class="flex items-end gap-4">
                <label class="check-label pb-2.5">
                    <input asp-for="NewHost.IsDefault" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500/30" />
                    设为全局默认
                </label>
                <button type="submit" class="btn-primary ml-auto"><svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>添加</button>
            </div>
        </form>
    </div>
</div>
