@page
@model AppPortal.Pages.Admin.SourcesModel
@{
    ViewData["Title"] = "数据源管理";
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a class="text-sm text-blue-600 hover:text-blue-800" asp-page="Index">&larr; 返回管理列表</a>
    </div>

    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">数据源</h1>
            <p class="text-sm text-gray-500 mt-1">从 Portainer 等渠道导入应用；后续可扩展其他来源</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="bg-blue-50 text-blue-800 rounded-lg p-3 text-sm mb-4">@Model.Message</div>
    }

    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-6">
        <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-200">
                <tr>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">名称</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">类型</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">状态</th>
                    <th class="text-left px-4 py-3 font-medium text-gray-600">最近同步</th>
                    <th class="text-right px-4 py-3 font-medium text-gray-600">操作</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var s in Model.Sources)
                {
                    <tr>
                        <td class="px-4 py-3 font-medium text-gray-900">@s.Name</td>
                        <td class="px-4 py-3 text-gray-600">@s.Type</td>
                        <td class="px-4 py-3">
                            @if (s.LastStatus == "connected" || s.LastStatus == "imported" || s.LastStatus == "updated")
                            {
                                <span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700">@s.LastStatus</span>
                            }
                            else if (s.LastStatus is not null)
                            {
                                <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">@s.LastStatus</span>
                            }
                            else
                            {
                                <span class="text-xs text-gray-400">未测试</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-gray-500 text-xs">@(s.LastSyncAt?.ToString("u") ?? "—")</td>
                        <td class="px-4 py-3 text-right space-x-2">
                            <a class="text-xs px-3 py-1.5 rounded-md border border-blue-200 text-blue-600 hover:bg-blue-50" asp-page="Import" asp-route-sourceId="@s.Id">导入</a>
                            <form method="post" asp-page-handler="Test" asp-route-id="@s.Id" class="inline">
                                <button type="submit" class="text-xs px-3 py-1.5 rounded-md border border-gray-200 text-gray-600 hover:bg-gray-50">测试连接</button>
                            </form>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="inline">
                                <button type="submit" class="text-xs px-3 py-1.5 rounded-md border border-red-200 text-red-500 hover:bg-red-50">删除</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Sources.Count == 0)
                {
                    <tr><td colspan="5" class="px-4 py-8 text-center text-gray-400">暂无数据源</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">新增 Portainer 数据源</h2>
        <form method="post" asp-page-handler="Create" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">名称 *</label>
                    <input asp-for="NewName" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="生产 Portainer" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">类型</label>
                    <select asp-for="NewType" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm">
                        <option value="Portainer">Portainer</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">BaseUrl *</label>
                    <input asp-for="NewBaseUrl" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="https://portainer.example.com" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">API Key</label>
                    <input asp-for="NewApiKey" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" placeholder="ptr_xxx" />
                </div>
            </div>
            <button type="submit" class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700 text-sm font-medium">保存并测试连接</button>
        </form>
    </div>
</div>
