@page
@using AppPortal.Models
@model AppPortal.Pages.Admin.SourcesModel
@{
    ViewData["Title"] = "数据源管理";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Index">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
        返回管理列表
    </a>

    <div class="mb-7">
        <h1 class="page-title">数据源</h1>
        <p class="page-desc">从 Portainer 等渠道导入应用；后续可扩展其他来源</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-info">@Model.Message</div>
    }

    <div class="table-panel mb-6"><div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-name">名称</th>
                    <th class="col-nowrap">类型</th>
                    <th class="col-nowrap">Host 绑定</th>
                    <th class="col-nowrap">状态</th>
                    <th class="col-nowrap col-meta">最近同步</th>
                    <th class="col-actions">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Sources)
                {
                    <tr>
                        <td class="col-name">@s.Name</td>
                        <td class="col-nowrap">@s.Type</td>
                        <td class="col-nowrap">
                            @{
                                var boundHosts = Model.Hosts.Where(h => s.HostIds.Contains(h.Id)).ToList();
                            }
                            @if (s.HostIds.Count == 0)
                            {
                                <span class="badge-muted">未绑定</span>
                            }
                            else if (boundHosts.Count == 0)
                            {
                                <span class="badge-warn">绑定已失效</span>
                            }
                            else
                            {
                                <span class="badge-info">@boundHosts.Count 个</span>
                            }
                        </td>
                        <td class="col-nowrap">
                            @if (s.LastStatus is "connected" or "imported" or "updated")
                            {
                                <span class="badge-success">@s.LastStatus</span>
                            }
                            else if (s.LastStatus is not null)
                            {
                                <span class="badge-warn">@s.LastStatus</span>
                            }
                            else
                            {
                                <span class="badge-muted">未测试</span>
                            }
                        </td>
                        <td class="col-meta col-nowrap">@(s.LastSyncAt?.ToString("u") ?? "—")</td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <a class="btn-primary btn-sm" asp-page="Import" asp-route-sourceId="@s.Id"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-download"></use></svg>导入</a>
                                <button type="button"
                                        class="btn-secondary btn-sm btn-edit-hosts"
                                        data-id="@s.Id"
                                        data-host-ids="@string.Join(",", s.HostIds)">
                                    <svg class="icon icon-sm" aria-hidden="true"><use href="#i-server"></use></svg>绑定 Host
                                </button>
                                <form method="post" asp-page-handler="Test" asp-route-id="@s.Id" class="inline">
                                    <button type="submit" class="btn-secondary btn-sm"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-refresh"></use></svg>测试连接</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="inline">
                                    <button type="submit" class="btn-danger btn-sm"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"></use></svg>删除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Sources.Count == 0)
                {
                    <tr class="empty-row">
                        <td colspan="6">暂无数据源，请在下方添加</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <div class="card card-pad">
        <h2 class="section-title mb-4">新增 Portainer 数据源</h2>
        <form method="post" asp-page-handler="Create" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="field-label">名称 *</label>
                    <input asp-for="NewName" class="input" placeholder="生产 Portainer" />
                </div>
                <div>
                    <label class="field-label">类型</label>
                    <select asp-for="NewType" class="select">
                        <option value="Portainer">Portainer</option>
                    </select>
                </div>
                <div>
                    <label class="field-label">BaseUrl *</label>
                    <input asp-for="NewBaseUrl" class="input" placeholder="https://portainer.example.com" />
                </div>
                <div>
                    <label class="field-label">API Key</label>
                    <input asp-for="NewApiKey" class="input" placeholder="ptr_xxx" />
                </div>
                <div class="sm:col-span-2">
                    <label class="field-label">绑定 Host（可选）</label>
                    @if (Model.Hosts.Count == 0)
                    {
                        <p class="field-hint">暂无 Host。可稍后在列表中「绑定 Host」；未绑定时导入将展示全部 Host。</p>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-2">
                            @foreach (var h in Model.Hosts.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                            {
                                <label class="inline-flex items-center gap-2 rounded-xl border border-gray-200/80 dark:border-gray-700/80 px-3 py-2 text-sm text-gray-700 dark:text-gray-200">
                                    <input type="checkbox" name="NewHostIds" value="@h.Id"
                                           class="rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500/30" />
                                    <span>@h.Name</span>
                                    <span class="text-xs text-gray-400 dark:text-gray-500 mono">@h.Addresses.Count IP</span>
                                </label>
                            }
                        </div>
                        <p class="field-hint mt-2">不选 = 未绑定，导入时展示全部 Host；绑定后导入仅使用所选 Host。</p>
                    }
                </div>
            </div>
            <button type="submit" class="btn-primary"><svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>保存并测试连接</button>
        </form>
    </div>
</div>

<!-- 绑定 Host 模态框 -->
<div id="sourceHostModal" class="fixed inset-0 z-50 hidden" aria-hidden="true">
    <div class="absolute inset-0 bg-gray-900/40 dark:bg-black/60" data-source-host-close></div>
    <div class="absolute inset-0 flex items-end sm:items-center justify-center p-4">
        <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] flex flex-col">
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 dark:border-gray-700/80 shrink-0">
                <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">绑定 Host</h2>
                <button type="button" class="btn-ghost !px-2 !py-2 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300" data-source-host-close aria-label="关闭">
                    <svg class="icon"><use href="#i-x"></use></svg>
                </button>
            </div>

            <form id="sourceHostForm" method="post" asp-page-handler="UpdateHosts" class="flex flex-col grow min-h-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="EditId" id="sourceEditId" value="" />

                <div class="px-5 py-4 overflow-y-auto grow space-y-3">
                    <p class="field-hint">导入时仅使用所选 Host；不选 = 未绑定（展示全部 Host）。</p>
                    @if (Model.Hosts.Count == 0)
                    {
                        <p class="text-sm text-amber-700 dark:text-amber-300">暂无 Host，请先在 Host 目录中添加。</p>
                    }
                    else
                    {
                        <div class="space-y-2" id="sourceHostChecks">
                            @foreach (var h in Model.Hosts.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                            {
                                <label class="flex items-center gap-2.5 rounded-xl border border-gray-200/80 dark:border-gray-700/80 px-3 py-2.5">
                                    <input type="checkbox" name="EditHostIds" value="@h.Id"
                                           class="rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500/30" />
                                    <span class="text-sm text-gray-800 dark:text-gray-100">@h.Name</span>
                                    <span class="text-xs text-gray-400 dark:text-gray-500 mono ml-auto">@string.Join(" · ", h.Addresses)</span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <div class="flex items-center gap-3 px-5 py-4 border-t border-gray-100 dark:border-gray-700/80 shrink-0 bg-white dark:bg-gray-900 rounded-b-2xl">
                    <button type="submit" class="btn-primary">保存</button>
                    <button type="button" class="btn-secondary" data-source-host-close>取消</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('sourceHostModal');
            var editId = document.getElementById('sourceEditId');
            if (!modal) return;

            function lockScroll(lock) {
                document.body.style.overflow = lock ? 'hidden' : '';
            }

            function openModal(id, hostIds) {
                editId.value = id || '';
                var selected = (hostIds || '').split(',').filter(Boolean);
                document.querySelectorAll('#sourceHostChecks input[name="EditHostIds"]').forEach(function (cb) {
                    cb.checked = selected.indexOf(cb.value) !== -1;
                });
                modal.classList.remove('hidden');
                modal.setAttribute('aria-hidden', 'false');
                lockScroll(true);
            }

            function closeModal() {
                modal.classList.add('hidden');
                modal.setAttribute('aria-hidden', 'true');
                lockScroll(false);
            }

            document.querySelectorAll('.btn-edit-hosts').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openModal(btn.getAttribute('data-id'), btn.getAttribute('data-host-ids'));
                });
            });

            modal.querySelectorAll('[data-source-host-close]').forEach(function (el) {
                el.addEventListener('click', closeModal);
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
            });
        })();
    </script>
}
