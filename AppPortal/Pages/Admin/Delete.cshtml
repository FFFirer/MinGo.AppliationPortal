@page "{id}"
@model AppPortal.Pages.Admin.DeleteModel
@{
    ViewData["Title"] = "删除应用";
}

<div class="max-w-lg mx-auto px-4 sm:px-6 py-8">
    <a class="back-link" asp-page="Index">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        返回管理列表
    </a>

    <div class="alert-warn">
        仅已禁用的应用可以删除。如需删除请先在列表中禁用该应用。
    </div>

    <div class="card card-pad">
        <h1 class="text-xl font-bold text-gray-900 mb-2">确认删除</h1>
        <p class="text-sm text-gray-500 mb-6">此操作不可恢复，请确认是否删除以下应用：</p>

        <div class="rounded-xl bg-gray-50/80 border border-gray-100 p-4 mb-6">
            <div class="flex items-center gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.App?.IconUrl))
                {
                    <div class="w-10 h-10 rounded-lg overflow-hidden bg-white flex items-center justify-center">
                        <img src="@Model.App.IconUrl" alt="" class="w-8 h-8 object-contain" />
                    </div>
                }
                else
                {
                    <div class="app-avatar-sm !w-10 !h-10">@(Model.App?.Name?[..1] ?? "?")</div>
                }
                <div>
                    <div class="font-medium text-gray-900">@Model.App?.Name</div>
                    @if (!string.IsNullOrEmpty(Model.App?.Description))
                    {
                        <div class="text-xs text-gray-500">@Model.App.Description</div>
                    }
                </div>
            </div>
            <div class="text-xs text-gray-500 flex flex-wrap items-center gap-x-4 gap-y-1">
                <span>模块：<span class="text-gray-700 font-medium">@(Model.App?.Modules.Count ?? 0)</span> 个</span>
                <span>排序：<span class="text-gray-700 font-medium">@Model.App?.SortOrder</span></span>
                <span>
                    状态：
                    @if (Model.App?.IsEnabled == true)
                    {
                        <span class="badge-success">启用</span>
                    }
                    else
                    {
                        <span class="badge-muted">禁用</span>
                    }
                </span>
            </div>
        </div>

        <form method="post">
            <div class="flex items-center gap-3">
                <button type="submit" class="btn-primary !bg-red-600 hover:!bg-red-700 !shadow-red-600/20">确认删除</button>
                <a class="btn-secondary" asp-page="Index">取消</a>
            </div>
        </form>
    </div>
</div>
