@page
@model AppPortal.Pages.Admin.CreateModel
@{
    ViewData["Title"] = "新增应用";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Index"><svg class="icon"><use href="#i-arrow-left"></use></svg>返回管理列表</a>

    <div class="card card-pad">
        <h1 class="text-xl font-bold text-gray-900 mb-6">新增应用</h1>

        <form method="post">
            <div class="space-y-5">
                <div>
                    <label class="field-label" asp-for="App.Name">应用名称 *</label>
                    <input class="input" asp-for="App.Name" />
                    <span class="field-error" asp-validation-for="App.Name"></span>
                </div>

                <div>
                    <label class="field-label" asp-for="App.Description">描述</label>
                    <textarea class="textarea" asp-for="App.Description" rows="2"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="sm:col-span-2">
                        <label class="field-label" asp-for="App.IconUrl">图标地址</label>
                        <input class="input" asp-for="App.IconUrl" placeholder="https://example.com/icon.png" />
                    </div>
                    <div>
                        <label class="field-label" asp-for="App.SortOrder">排序</label>
                        <input class="input" asp-for="App.SortOrder" type="number" min="0" />
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-3">
                        <label class="field-label !mb-0">模块 *</label>
                        <button type="button" id="btnAddModule" class="btn-secondary btn-sm">
                            <svg class="icon icon-sm"><use href="#i-plus"></use></svg>添加模块
                        </button>
                    </div>
                    <p class="field-hint mb-3">应用下可挂多个模块；每个地址一行，Host / 协议 / 地址 / 端口(可选) / 路径(可选) 都在行内。</p>

                    <div id="moduleList" class="space-y-4">
                        @for (var mi = 0; mi < Model.App.Modules.Count; mi++)
                        {
                            var mod = Model.App.Modules[mi];
                            <div class="module-block rounded-2xl border border-gray-200/80 bg-gray-50/50 p-4">
                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    <input class="input !w-auto flex-1 min-w-[10rem]" name="App.Modules[@mi].Name" value="@mod.Name" placeholder="模块名称" />
                                    <input class="input !w-20" name="App.Modules[@mi].Order" value="@mod.Order" type="number" placeholder="排序" />
                                    <label class="check-label whitespace-nowrap">
                                        <input type="checkbox" name="App.Modules[@mi].IsEnabled" value="true" checked="@mod.IsEnabled" />
                                        启用
                                    </label>
                                    <input type="hidden" name="App.Modules[@mi].IsEnabled" value="false" />
                                    <button type="button" class="btn-ghost !px-2 !py-2 text-gray-400 hover:text-red-500 btn-remove-module" title="删除模块">
                                        <svg class="icon"><use href="#i-trash"></use></svg>
                                    </button>
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-xs font-medium text-gray-500">地址（一行一个）</span>
                                        <button type="button" class="btn-add-addr text-xs text-blue-600 hover:text-blue-800">+ 添加地址</button>
                                    </div>
                                    <div class="addr-list space-y-2">
                                        @for (var ai = 0; ai < mod.Addresses.Count; ai++)
                                        {
                                            var addr = mod.Addresses[ai];
                                            <div class="addr-row">
                                                <select class="select !w-28 !py-1.5 !px-2 !text-sm !shrink-0" name="App.Modules[@mi].Addresses[@ai].HostId" data-host-select>
                                                    <option value="">Host…</option>
                                                    @foreach (var h in Model.Hosts)
                                                    {
                                                        <option value="@h.Id"
                                                                data-addresses="@string.Join("|", h.Addresses)"
                                                                selected="@(addr.HostId == h.Id)">
                                                            @h.Name
                                                        </option>
                                                    }
                                                </select>
                                                <select class="select !w-[4.5rem] !py-1.5 !px-2 !text-sm !shrink-0" name="App.Modules[@mi].Addresses[@ai].Scheme">
                                                    <option value="http" selected="@(addr.Scheme != "https")">http</option>
                                                    <option value="https" selected="@(addr.Scheme == "https")">https</option>
                                                </select>
                                                <span class="sep">://</span>
                                                <input class="input !w-28 !py-1.5 !text-sm !min-w-0 !shrink" name="App.Modules[@mi].Addresses[@ai].Address" value="@addr.Address" placeholder="10.0.0.5" />
                                                <span class="sep">:</span>
                                                <input class="input !w-16 !py-1.5 !text-sm !shrink-0" name="App.Modules[@mi].Addresses[@ai].Port" value="@addr.Port" type="number" min="1" placeholder="端口" />
                                                <span class="sep">/</span>
                                                <input class="input !w-20 !py-1.5 !text-sm !shrink-0" name="App.Modules[@mi].Addresses[@ai].Path" value="@addr.Path" placeholder="路径(可选)" />
                                                <button type="button" class="btn-remove-addr text-gray-300 hover:text-red-500 p-1 ml-auto">
                                                    <svg class="icon icon-sm"><use href="#i-x"></use></svg>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <span class="field-error" asp-validation-for="App.Modules"></span>
                </div>

                <div class="flex items-center gap-3 pt-2">
                    <button type="submit" class="btn-primary"><svg class="icon"><use href="#i-check"></use></svg>保存</button>
                    <a class="btn-secondary" asp-page="Index">取消</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function hostOptions(mi) {
                var hosts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Hosts.Select(h => new {
                    id = h.Id.ToString(),
                    name = h.Name,
                    addresses = string.Join("|", h.Addresses)
                })));
                return ['<option value="">Host…</option>'].concat(hosts.map(function (h) {
                    return '<option value="' + h.id + '" data-addresses="' + h.addresses + '">' + h.name + '</option>';
                })).join('');
            }

            function addrRowHtml(mi, ai) {
                return [
                    '<select class="select !w-28 !py-1.5 !px-2 !text-sm !shrink-0" name="App.Modules[' + mi + '].Addresses[' + ai + '].HostId" data-host-select>',
                    hostOptions(mi),
                    '</select>',
                    '<select class="select !w-[4.5rem] !py-1.5 !px-2 !text-sm !shrink-0" name="App.Modules[' + mi + '].Addresses[' + ai + '].Scheme">',
                    '<option value="http">http</option><option value="https">https</option></select>',
                    '<span class="sep">://</span>',
                    '<input class="input !w-28 !py-1.5 !text-sm !min-w-0 !shrink" name="App.Modules[' + mi + '].Addresses[' + ai + '].Address" placeholder="10.0.0.5" />',
                    '<span class="sep">:</span>',
                    '<input class="input !w-16 !py-1.5 !text-sm !shrink-0" name="App.Modules[' + mi + '].Addresses[' + ai + '].Port" type="number" min="1" placeholder="端口" />',
                    '<span class="sep">/</span>',
                    '<input class="input !w-20 !py-1.5 !text-sm !shrink-0" name="App.Modules[' + mi + '].Addresses[' + ai + '].Path" placeholder="路径(可选)" />',
                    '<button type="button" class="btn-remove-addr text-gray-300 hover:text-red-500 p-1 ml-auto">',
                    '<svg class="icon icon-sm"><use href="#i-x"></use></svg></button>'
                ].join('');
            }

            function reindex() {
                document.querySelectorAll('.module-block').forEach(function (mod, mi) {
                    mod.querySelectorAll('input,select').forEach(function (el) {
                        if (!el.name) return;
                        el.name = el.name.replace(/App\.Modules\[\d+\]/, 'App.Modules[' + mi + ']');
                    });
                    mod.querySelectorAll('.addr-row').forEach(function (row, ai) {
                        row.querySelectorAll('input,select').forEach(function (el) {
                            if (!el.name) return;
                            el.name = el.name.replace(/Addresses\[\d+\]/, 'Addresses[' + ai + ']');
                        });
                    });
                });
            }

            function bind() {
                document.querySelectorAll('.btn-remove-module').forEach(function (btn) {
                    btn.onclick = function () {
                        if (document.querySelectorAll('.module-block').length > 1) {
                            btn.closest('.module-block').remove();
                            reindex();
                        }
                    };
                });

                document.querySelectorAll('.btn-add-addr').forEach(function (btn) {
                    btn.onclick = function () {
                        var block = btn.closest('.module-block');
                        var mi = Array.prototype.indexOf.call(document.querySelectorAll('.module-block'), block);
                        var ai = block.querySelectorAll('.addr-row').length;
                        var row = document.createElement('div');
                        row.className = 'addr-row';
                        row.innerHTML = addrRowHtml(mi, ai);
                        block.querySelector('.addr-list').appendChild(row);
                        bind();
                        reindex();
                    };
                });

                document.querySelectorAll('.btn-remove-addr').forEach(function (btn) {
                    btn.onclick = function () {
                        var rows = btn.closest('.addr-list').querySelectorAll('.addr-row');
                        if (rows.length > 1) {
                            btn.closest('.addr-row').remove();
                            reindex();
                        }
                    };
                });

                document.querySelectorAll('[data-host-select]').forEach(function (sel) {
                    sel.onchange = function () {
                        var addrs = (sel.options[sel.selectedIndex].getAttribute('data-addresses') || '')
                            .split('|').filter(Boolean);
                        if (!addrs.length) return;
                        var row = sel.closest('.addr-row');
                        var addrInput = row.querySelector('input[name$=".Address"]');
                        if (addrInput && !addrInput.value && addrs[0]) {
                            addrInput.value = addrs[0];
                        }
                    };
                });
            }

            document.getElementById('btnAddModule').addEventListener('click', function () {
                var list = document.getElementById('moduleList');
                var mi = list.querySelectorAll('.module-block').length;
                var div = document.createElement('div');
                div.className = 'module-block rounded-2xl border border-gray-200/80 bg-gray-50/50 p-4';
                div.innerHTML = [
                    '<div class="flex flex-wrap items-center gap-2 mb-3">',
                    '<input class="input !w-auto flex-1 min-w-[10rem]" name="App.Modules[' + mi + '].Name" placeholder="模块名称" />',
                    '<input class="input !w-20" name="App.Modules[' + mi + '].Order" type="number" placeholder="排序" />',
                    '<label class="check-label whitespace-nowrap"><input type="checkbox" name="App.Modules[' + mi + '].IsEnabled" value="true" checked /> 启用</label>',
                    '<input type="hidden" name="App.Modules[' + mi + '].IsEnabled" value="false" />',
                    '<button type="button" class="btn-ghost !px-2 !py-2 text-gray-400 hover:text-red-500 btn-remove-module"><svg class="icon"><use href="#i-trash"></use></svg></button>',
                    '</div>',
                    '<div>',
                    '<div class="flex items-center justify-between mb-2"><span class="text-xs font-medium text-gray-500">地址（一行一个）</span>',
                    '<button type="button" class="btn-add-addr text-xs text-blue-600 hover:text-blue-800">+ 添加地址</button></div>',
                    '<div class="addr-list space-y-2"></div>',
                    '</div>'
                ].join('');
                list.appendChild(div);
                div.querySelector('.btn-add-addr').click();
                bind();
                reindex();
            });

            bind();
        })();
    </script>
}
