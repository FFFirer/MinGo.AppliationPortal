@page "{sourceId}/{environmentId?}"
@model AppPortal.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "从数据源导入";
}

<div class="page-shell">
    <a class="back-link" asp-page="Sources">
        <svg class="icon"><use href="#i-arrow-left"></use></svg>
        返回数据源
    </a>

    <div class="mb-7">
        <h1 class="page-title">导入应用</h1>
        @if (Model.Source is not null)
        {
            <p class="page-desc">
                数据源：@Model.Source.Name · <span class="badge-info align-middle">@Model.Source.Type</span>
                @if (Model.Environment is not null)
                {
                    <span class="mx-1 text-gray-300 dark:text-gray-600">/</span>
                    <span>Environment：@Model.Environment.Name</span>
                    <span class="badge-muted align-middle mono">endpoint #@Model.Environment.EndpointId</span>
                }
            </p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-error">@Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-info">@Model.Message</div>
    }
    @if (Model.HostBindingStale)
    {
        <div class="alert-warn">Environment 绑定的 Host 已失效，已回落为展示全部 Host。</div>
    }

    @if (Model.Draft is null)
    {
        if (Model.Candidates.Count == 0)
        {
            <div class="card card-pad text-center text-gray-400 dark:text-gray-500 py-12">未找到 compose project</div>
        }
        else
        {
            <div class="space-y-2.5">
                @foreach (var c in Model.Candidates)
                {
                    <div class="card card-pad">
                        <div class="flex flex-wrap items-start sm:items-center gap-x-4 gap-y-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h2 class="font-semibold text-gray-900 dark:text-gray-100 break-all">@c.Name</h2>
                                    <span class="badge-muted">@c.Kind</span>
                                </div>
                                <p class="text-xs text-gray-400 dark:text-gray-500 mono mt-1.5 break-all">@c.Meta</p>
                            </div>
                            <a class="btn-primary btn-sm shrink-0"
                               asp-page="Import"
                               asp-route-sourceId="@Model.Source?.Id"
                               asp-route-environmentId="@Model.Environment?.Id"
                               asp-route-externalId="@c.ExternalId">
                                <svg class="icon icon-sm"><use href="#i-download"></use></svg>预览
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <form method="post" id="importForm">
            <input type="hidden" name="SelectedExternalId" value="@Model.Draft.ExternalId" />

            <div class="card card-pad mb-5">
                <h2 class="section-title mb-3">批量改写地址</h2>
                <p class="field-hint mb-3">按服务端口生成完整 URL；可在下方逐条修改后导入。地址最终以 URL 字符串保存。</p>
                <div class="space-y-4">
                    @* 必填字段在前 *@
                    <div>
                        <label class="field-label">协议 *</label>
                        <select asp-for="GenScheme" class="select" id="genScheme">
                            <option value="http">http</option>
                            <option value="https">https</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">主机 *（可多选）</label>
                        @if (Model.Hosts.Count == 0)
                        {
                            <p class="text-sm text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-500/15 border border-amber-200/70 dark:border-amber-400/25 rounded-xl px-3 py-2">
                                暂无 Host，请先在 Host 目录中添加。
                            </p>
                        }
                        else
                        {
                            <div class="space-y-2" id="genHostChecks">
                                @foreach (var h in Model.Hosts.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                                {
                                    var isChecked = Model.GenHostIds.Contains(h.Id.ToString());
                                    <label class="flex items-center gap-2.5 rounded-xl border border-gray-200/80 dark:border-gray-700/80 px-3 py-2.5">
                                        <input type="checkbox"
                                               name="GenHostIds"
                                               value="@h.Id"
                                               @(isChecked ? "checked" : null)
                                               data-ips="@string.Join("|", h.Addresses)"
                                               class="gen-host-cb rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500/30" />
                                        <span class="text-sm text-gray-800 dark:text-gray-100">@h.Name@(h.IsDefault ? "（默认）" : "")</span>
                                        <span class="text-xs text-gray-400 dark:text-gray-500 mono ml-auto">@h.Addresses.Count 个 IP</span>
                                    </label>
                                }
                            </div>
                            <div class="mt-3 rounded-xl border border-blue-200/70 dark:border-blue-400/25 bg-blue-50/70 dark:bg-blue-500/10 px-3 py-2.5">
                                <div class="flex items-center gap-2 mb-2">
                                    <svg class="icon text-blue-600 dark:text-blue-400"><use href="#i-server"></use></svg>
                                    <span class="text-xs text-blue-700 dark:text-blue-300">已选 IP（去重后将全部用于生成地址）· <span id="hostIpCount">0</span> 个</span>
                                </div>
                                <div class="flex flex-wrap gap-1.5" id="hostIpPreview"></div>
                            </div>
                        }
                    </div>
                    @* 可选字段在后 *@
                    <div>
                        <label class="field-label">路径（可选）</label>
                        <input asp-for="GenPath" class="input" id="genPath" placeholder="/admin 或留空" />
                    </div>
                </div>
                <div class="mt-3 flex gap-2">
                    <button type="submit" formaction="@Url.Page("Import", "Rewrite", new { sourceId = Model.Source?.Id, environmentId = Model.Environment?.Id })"
                            class="btn-secondary">
                        <svg class="icon"><use href="#i-refresh"></use></svg>按此配置刷新地址
                    </button>
                </div>
            </div>

            <div class="card card-pad space-y-5">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">@Model.Draft.Name</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">@Model.Draft.Description</p>
                    <p class="text-xs text-gray-400 dark:text-gray-500 mono mt-1.5">ExternalId · @Model.Draft.ExternalId</p>
                </div>

                @for (var mi = 0; mi < Model.Draft.Modules.Count; mi++)
                {
                    var mod = Model.Draft.Modules[mi];
                    <div class="rounded-2xl border border-gray-200/80 dark:border-gray-700/80 bg-gray-50/50 dark:bg-gray-800/50 p-4">
                        <div class="flex items-center justify-between mb-3">
                            <div class="font-semibold text-gray-900 dark:text-gray-100">@mod.Name</div>
                            <span class="badge-muted">service: @mod.SourceService</span>
                        </div>
                        <div class="space-y-2">
                            @for (var ai = 0; ai < mod.Addresses.Count; ai++)
                            {
                                var addr = mod.Addresses[ai];
                                <div class="addr-row">
                                    <input type="checkbox"
                                           name="Sel_@(mi)_@(ai)"
                                           value="true"
                                           @(addr.Selected ? "checked" : null)
                                           class="shrink-0 rounded border-gray-300 dark:border-gray-600 text-blue-600 dark:text-blue-400 focus:ring-blue-500/30" />
                                    <input class="input !py-1.5 !text-sm !min-w-0 !shrink"
                                           name="Url_@(mi)_@(ai)"
                                           value="@addr.Url"
                                           placeholder="http://host:port/"
                                           data-url-input />
                                    @if (!string.IsNullOrEmpty(addr.Label))
                                    {
                                        <span class="badge-muted mono shrink-0">@addr.Label</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="flex items-center gap-3 pt-1">
                    <button type="submit" formaction="@Url.Page("Import", "Import", new { sourceId = Model.Source?.Id, environmentId = Model.Environment?.Id })"
                            class="btn-primary">
                        <svg class="icon"><use href="#i-download"></use></svg>确认导入
                    </button>
                    <a class="btn-secondary" asp-page="Import" asp-route-sourceId="@Model.Source?.Id" asp-route-environmentId="@Model.Environment?.Id">返回列表</a>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var checks = document.querySelectorAll('.gen-host-cb');
            var preview = document.getElementById('hostIpPreview');
            var countEl = document.getElementById('hostIpCount');
            if (!checks.length || !preview) return;

            function syncHostIps() {
                var seen = {};
                var ips = [];
                checks.forEach(function (cb) {
                    if (!cb.checked) return;
                    var raw = cb.getAttribute('data-ips') || '';
                    raw.split('|').filter(Boolean).forEach(function (ip) {
                        if (!seen[ip]) {
                            seen[ip] = true;
                            ips.push(ip);
                        }
                    });
                });

                preview.innerHTML = '';
                if (countEl) countEl.textContent = String(ips.length);
                if (ips.length === 0) {
                    var empty = document.createElement('span');
                    empty.className = 'text-xs text-blue-700 dark:text-blue-300';
                    empty.textContent = '未选择 Host 或所选 Host 暂无 IP';
                    preview.appendChild(empty);
                    return;
                }
                ips.forEach(function (ip) {
                    var chip = document.createElement('span');
                    chip.className = 'inline-flex items-center gap-1 rounded-full bg-blue-600 dark:bg-blue-500 text-white text-xs font-medium px-2.5 py-1 mono';
                    chip.innerHTML = '<svg class="icon icon-sm opacity-90"><use href="#i-check"></use></svg>';
                    chip.appendChild(document.createTextNode(ip));
                    preview.appendChild(chip);
                });
            }

            checks.forEach(function (cb) {
                cb.addEventListener('change', syncHostIps);
            });
            syncHostIps();
        })();
    </script>
}
