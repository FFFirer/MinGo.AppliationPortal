@page "{sourceId}"
@model AppPortal.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "从数据源导入";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Sources">
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left"></use></svg>
        返回数据源
    </a>

    <div class="mb-7">
        <h1 class="page-title">导入应用</h1>
        @if (Model.Source is not null)
        {
            <p class="page-desc">数据源：@Model.Source.Name · <span class="badge-info align-middle">@Model.Source.Type</span></p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-error">@Model.Error</div>
    }

    @if (Model.Draft is null)
    {
        <div class="table-panel"><div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>名称</th>
                        <th>类型</th>
                        <th>元数据</th>
                        <th class="!text-right">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Candidates)
                    {
                        <tr>
                            <td class="!font-medium !text-gray-900">@c.Name</td>
                            <td>@c.Kind</td>
                            <td class="!text-xs !text-gray-400 mono">@c.Meta</td>
                            <td>
                                <div class="flex justify-end">
                                    <a class="btn-primary btn-sm"
                                       asp-page="Import"
                                       asp-route-sourceId="@Model.Source?.Id"
                                       asp-route-externalId="@c.ExternalId">
                                        预览
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.Candidates.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="!py-12 text-center text-gray-400">未找到 stack</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
    else
    {
        <form method="post" asp-page-handler="Import" asp-route-sourceId="@Model.Source?.Id">
            <input type="hidden" name="SelectedExternalId" value="@Model.Draft.ExternalId" />
            <div class="card card-pad space-y-5">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">@Model.Draft.Name</h2>
                    <p class="text-sm text-gray-500 mt-1">@Model.Draft.Description</p>
                    <p class="text-xs text-gray-400 mono mt-1.5">ExternalId · @Model.Draft.ExternalId</p>
                </div>

                @for (var mi = 0; mi < Model.Draft.Modules.Count; mi++)
                {
                    var mod = Model.Draft.Modules[mi];
                    <div class="rounded-xl border border-gray-200/80 p-4 bg-gray-50/40">
                        <div class="flex items-center gap-3 mb-3">
                            <label class="field-label !mb-0 shrink-0">模块名</label>
                            <input class="input !py-2 flex-1" name="ModuleName_@mi" value="@mod.Name" />
                            <span class="text-xs text-gray-400 mono shrink-0">@mod.SourceService</span>
                        </div>
                        <div class="space-y-2">
                            @for (var ei = 0; ei < mod.Endpoints.Count; ei++)
                            {
                                var ep = mod.Endpoints[ei];
                                <div class="import-endpoint">
                                    <input type="checkbox" name="Selected_@(mi)_@(ei)" value="true" checked="@ep.Selected"
                                           class="rounded border-gray-300 text-blue-600 focus:ring-blue-500/30" />
                                    <span class="w-40 truncate font-medium text-gray-800">@ep.DisplayName</span>
                                    <span class="text-xs text-gray-500 mono">
                                        @(ep.HostPort?.ToString() ?? "—") → @(ep.ContainerPort?.ToString() ?? "—") · @ep.Scheme
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="flex items-center gap-3 pt-1">
                    <button type="submit" class="btn-primary"><svg class="icon" aria-hidden="true"><use href="#i-download"></use></svg>确认导入</button>
                    <a class="btn-secondary" asp-page="Import" asp-route-sourceId="@Model.Source?.Id">返回列表</a>
                </div>
            </div>
        </form>
    }
</div>
