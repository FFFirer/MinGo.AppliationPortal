@page "{sourceId}"
@model AppPortal.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "从数据源导入";
}

<div class="page-shell-narrow">
    <a class="back-link" asp-page="Sources">
        <svg class="icon"><use href="#i-arrow-left"></use></svg>
        返回数据源
    </a>

    <div class="mb-7">
        <h1 class="page-title">导入应用</h1>
        @if (Model.Source is not null)
        {
            <p class="page-desc">数据源：@Model.Source.Name · <span class="badge-info align-middle">@Model.Source.Type</span></p>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-error">@Model.Error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-info">@Model.Message</div>
    }

    @if (Model.Draft is null)
    {
        if (Model.Candidates.Count == 0)
        {
            <div class="card card-pad text-center text-gray-400 py-12">未找到 stack</div>
        }
        else
        {
            <div class="space-y-2.5">
                @foreach (var c in Model.Candidates)
                {
                    <div class="card card-pad">
                        <div class="flex flex-wrap items-start sm:items-center gap-x-4 gap-y-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h2 class="font-semibold text-gray-900 break-all">@c.Name</h2>
                                    <span class="badge-muted">@c.Kind</span>
                                </div>
                                <p class="text-xs text-gray-400 mono mt-1.5 break-all">@c.Meta</p>
                            </div>
                            <a class="btn-primary btn-sm shrink-0"
                               asp-page="Import"
                               asp-route-sourceId="@Model.Source?.Id"
                               asp-route-externalId="@c.ExternalId">
                                <svg class="icon icon-sm"><use href="#i-download"></use></svg>预览
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <form method="post" id="importForm">
            <input type="hidden" name="SelectedExternalId" value="@Model.Draft.ExternalId" />

            <div class="card card-pad mb-5">
                <h2 class="section-title mb-3">批量改写地址</h2>
                <p class="field-hint mb-3">按服务端口生成完整 URL；可在下方逐条修改后导入。地址最终以 URL 字符串保存。</p>
                <div class="space-y-4">
                    @* 必填字段在前 *@
                    <div>
                        <label class="field-label">协议 *</label>
                        <select asp-for="GenScheme" class="select" id="genScheme">
                            <option value="http">http</option>
                            <option value="https">https</option>
                        </select>
                    </div>
                    <div>
                        <label class="field-label">主机 *</label>
                        @if (Model.Hosts.Count == 0)
                        {
                            <p class="text-sm text-amber-700 bg-amber-50 border border-amber-200/70 rounded-xl px-3 py-2">
                                暂无 Host，请先在 Host 目录中添加。
                            </p>
                        }
                        else
                        {
                            <select asp-for="GenHostId" class="select" id="genHostId">
                                @foreach (var h in Model.Hosts.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                                {
                                    <option value="@h.Id"
                                            data-ips="@string.Join("|", h.Addresses)"
                                            selected="@(string.Equals(Model.GenHostId, h.Id.ToString(), StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @h.Name@(h.IsDefault ? "（默认）" : "") — @h.Addresses.Count 个 IP
                                    </option>
                                }
                            </select>
                            <div class="mt-3 rounded-xl border border-blue-200/70 bg-blue-50/70 px-3 py-2.5">
                                <div class="flex items-center gap-2 mb-2">
                                    <svg class="icon text-blue-600"><use href="#i-server"></use></svg>
                                    <span class="text-xs text-blue-700">已选 IP（将全部用于生成地址）</span>
                                </div>
                                <div class="flex flex-wrap gap-1.5" id="hostIpPreview">
                                    @foreach (var ip in (Model.Hosts.FirstOrDefault(h => h.Id.ToString() == Model.GenHostId)?.Addresses ?? Model.Hosts.FirstOrDefault()?.Addresses ?? new List<string>()))
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-600 text-white text-xs font-medium px-2.5 py-1 mono">
                                            <svg class="icon icon-sm opacity-90"><use href="#i-check"></use></svg>
                                            @ip
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    @* 可选字段在后 *@
                    <div>
                        <label class="field-label">路径（可选）</label>
                        <input asp-for="GenPath" class="input" id="genPath" placeholder="/admin 或留空" />
                    </div>
                </div>
                <div class="mt-3 flex gap-2">
                    <button type="submit" formaction="@Url.Page("Import", "Rewrite", new { sourceId = Model.Source?.Id })"
                            class="btn-secondary">
                        <svg class="icon"><use href="#i-refresh"></use></svg>按此配置刷新地址
                    </button>
                </div>
            </div>

            <div class="card card-pad space-y-5">
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">@Model.Draft.Name</h2>
                    <p class="text-sm text-gray-500 mt-1">@Model.Draft.Description</p>
                    <p class="text-xs text-gray-400 mono mt-1.5">ExternalId · @Model.Draft.ExternalId</p>
                </div>

                @for (var mi = 0; mi < Model.Draft.Modules.Count; mi++)
                {
                    var mod = Model.Draft.Modules[mi];
                    <div class="rounded-2xl border border-gray-200/80 bg-gray-50/50 p-4">
                        <div class="flex items-center justify-between mb-3">
                            <div class="font-semibold text-gray-900">@mod.Name</div>
                            <span class="badge-muted">service: @mod.SourceService</span>
                        </div>
                        <div class="space-y-2">
                            @for (var ai = 0; ai < mod.Addresses.Count; ai++)
                            {
                                var addr = mod.Addresses[ai];
                                <div class="addr-row">
                                    <input type="checkbox"
                                           name="Sel_@(mi)_@(ai)"
                                           value="true"
                                           @(addr.Selected ? "checked" : null)
                                           class="shrink-0 rounded border-gray-300 text-blue-600 focus:ring-blue-500/30" />
                                    <input class="input !py-1.5 !text-sm !min-w-0 !shrink"
                                           name="Url_@(mi)_@(ai)"
                                           value="@addr.Url"
                                           placeholder="http://host:port/"
                                           data-url-input />
                                    @if (!string.IsNullOrEmpty(addr.Label))
                                    {
                                        <span class="badge-muted mono shrink-0">@addr.Label</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="flex items-center gap-3 pt-1">
                    <button type="submit" formaction="@Url.Page("Import", "Import", new { sourceId = Model.Source?.Id })"
                            class="btn-primary">
                        <svg class="icon"><use href="#i-download"></use></svg>确认导入
                    </button>
                    <a class="btn-secondary" asp-page="Import" asp-route-sourceId="@Model.Source?.Id">返回列表</a>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('genHostId');
            var preview = document.getElementById('hostIpPreview');
            if (!sel || !preview) return;

            function syncHostIps() {
                var opt = sel.options[sel.selectedIndex];
                var raw = (opt && opt.getAttribute('data-ips')) || '';
                var ips = raw.split('|').filter(Boolean);
                preview.innerHTML = '';
                if (ips.length === 0) {
                    var empty = document.createElement('span');
                    empty.className = 'text-xs text-blue-700';
                    empty.textContent = '该 Host 暂无 IP';
                    preview.appendChild(empty);
                    return;
                }
                ips.forEach(function (ip) {
                    var chip = document.createElement('span');
                    chip.className = 'inline-flex items-center gap-1 rounded-full bg-blue-600 text-white text-xs font-medium px-2.5 py-1 mono';
                    chip.innerHTML = '<svg class="icon icon-sm opacity-90"><use href="#i-check"></use></svg>';
                    chip.appendChild(document.createTextNode(ip));
                    preview.appendChild(chip);
                });
            }

            sel.addEventListener('change', syncHostIps);
            syncHostIps();
        })();
    </script>
}
