@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
}

<div class="page-shell">
    @if (Model.Apps.Count == 0)
    {
        <div class="empty-state max-w-lg mx-auto">
            <div class="empty-icon"><svg class="icon icon-xl" aria-hidden="true"><use href="#i-package"></use></svg></div>
            <h2 class="empty-title">暂无可用应用</h2>
            <p class="empty-desc mb-6">当前没有已启用的应用，请联系管理员。</p>
            <a class="btn-primary" asp-page="/Admin/Index"><svg class="icon" aria-hidden="true"><use href="#i-settings"></use></svg>前往管理后台</a>
        </div>
    }
    else
    {
        <div class="mb-8">
            <h1 class="page-title">应用中心</h1>
            <p class="page-desc">选择一个应用查看入口</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            @foreach (var app in Model.Apps)
            {
                <a asp-page="/Detail" asp-route-id="@app.Id" class="card-hover p-6 flex flex-col group">
                    @if (!string.IsNullOrEmpty(app.IconUrl))
                    {
                        <div class="mb-4 w-12 h-12 rounded-xl overflow-hidden bg-gray-50 dark:bg-gray-800 flex items-center justify-center">
                            <img src="@app.IconUrl" alt="@app.Name" class="w-10 h-10 object-contain" />
                        </div>
                    }
                    else
                    {
                        <div class="app-avatar-md mb-4">@app.Name[..1]</div>
                    }

                    <h3 class="text-base font-semibold text-gray-900 dark:text-gray-100 mb-1 truncate group-hover:text-blue-700 dark:group-hover:text-blue-400 transition-colors" title="@app.Name">@app.Name</h3>
                    @if (!string.IsNullOrEmpty(app.Description))
                    {
                        <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2 leading-relaxed">@app.Description</p>
                    }

                    <div class="mt-auto pt-5 flex items-center justify-between text-xs">
                        <span class="text-gray-400 dark:text-gray-500">@app.Modules.Count(m => m.IsEnabled) 个模块</span>
                        <span class="text-blue-600 dark:text-blue-400 font-medium group-hover:translate-x-0.5 transition-transform">查看详情 <svg class="icon icon-sm" aria-hidden="true"><use href="#i-external"></use></svg></span>
                    </div>
                </a>
            }
        </div>
    }
</div>
