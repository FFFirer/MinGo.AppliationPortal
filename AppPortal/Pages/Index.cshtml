@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
}

@if (Model.Apps.Count == 0)
{
    <div class="text-center py-20">
        <div class="text-6xl mb-4">📋</div>
        <h2 class="text-2xl font-semibold text-gray-700 mb-2">暂无可用应用</h2>
        <p class="text-gray-500 mb-6">当前没有已启用的应用，请联系管理员。</p>
        <a class="inline-block bg-blue-600 text-white px-6 py-2.5 rounded-lg hover:bg-blue-700 transition-colors text-sm font-medium" asp-page="/Admin/Index">前往管理后台</a>
    </div>
}
else
{
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">应用中心</h1>
        <p class="text-gray-500 mt-1">选择一个应用查看入口</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @foreach (var app in Model.Apps)
        {
            <a asp-page="/Detail" asp-route-id="@app.Id"
               class="bg-white rounded-xl shadow-sm border border-gray-200 hover:shadow-md hover:border-blue-200 transition-all p-6 flex flex-col group">
                @if (!string.IsNullOrEmpty(app.IconUrl))
                {
                    <div class="mb-4">
                        <img src="@app.IconUrl" alt="@app.Name" class="w-12 h-12 object-contain" />
                    </div>
                }
                else
                {
                    <div class="mb-4 w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-xl text-blue-600 font-bold">
                        @app.Name[..1]
                    </div>
                }

                <h3 class="text-lg font-semibold text-gray-900 mb-1 truncate group-hover:text-blue-700 transition-colors" title="@app.Name">@app.Name</h3>
                @if (!string.IsNullOrEmpty(app.Description))
                {
                    <p class="text-sm text-gray-500 line-clamp-2">@app.Description</p>
                }

                <div class="mt-auto pt-4 flex items-center text-xs text-gray-400">
                    <span>@app.Modules.Count(m => m.IsEnabled) 个模块</span>
                    <span class="mx-2">·</span>
                    <span class="text-blue-600 group-hover:underline">查看详情 →</span>
                </div>
            </a>
        }
    </div>
}
