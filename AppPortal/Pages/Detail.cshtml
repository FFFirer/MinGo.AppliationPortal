@page "{id}"
@model AppPortal.Pages.DetailModel
@{
    ViewData["Title"] = Model.App.Name;
}

<div class="max-w-3xl mx-auto">
    <div class="mb-6">
        <a class="text-sm text-blue-600 hover:text-blue-800 transition-colors" asp-page="/Index">&larr; 返回应用中心</a>
    </div>

    <div class="bg-white rounded-xl border border-gray-200 p-6 mb-6">
        <div class="flex items-start gap-4">
            @if (!string.IsNullOrEmpty(Model.App.IconUrl))
            {
                <img src="@Model.App.IconUrl" alt="@Model.App.Name" class="w-14 h-14 object-contain rounded-lg" />
            }
            else
            {
                <div class="w-14 h-14 bg-blue-100 rounded-lg flex items-center justify-center text-2xl font-bold text-blue-600">
                    @Model.App.Name[..1]
                </div>
            }
            <div class="flex-1 min-w-0">
                <h1 class="text-2xl font-bold text-gray-900">@Model.App.Name</h1>
                @if (!string.IsNullOrEmpty(Model.App.Description))
                {
                    <p class="text-gray-500 mt-1">@Model.App.Description</p>
                }
                <p class="text-xs text-gray-400 mt-2">来源：@Model.SourceLabel</p>
            </div>
        </div>
    </div>

    @if (Model.Hosts.Count > 1)
    {
        <div class="mb-6 flex flex-wrap items-center gap-2">
            <span class="text-sm text-gray-500 mr-1">访问网络</span>
            @foreach (var h in Model.Hosts)
            {
                var isActive = Model.ActiveHost?.Id == h.Id;
                <a class="px-3 py-1.5 rounded-full text-sm border transition-colors @(isActive ? "bg-blue-600 text-white border-blue-600" : "bg-white text-gray-600 border-gray-200 hover:border-blue-300 hover:text-blue-700")"
                   asp-page="/Detail"
                   asp-route-id="@Model.App.Id"
                   asp-route-host="@h.Id">
                    @h.Name
                </a>
            }
        </div>
    }
    else if (Model.ActiveHost is not null)
    {
        <div class="mb-4 text-sm text-gray-500">
            访问网络：<span class="text-gray-800 font-medium">@Model.ActiveHost.Name</span>
            <span class="text-gray-400">（@Model.ActiveHost.Address）</span>
        </div>
    }

    @if (Model.ModuleViews.Count == 0)
    {
        <div class="text-center py-16 bg-white rounded-xl border border-gray-200">
            <div class="text-4xl mb-3">🔗</div>
            <p class="text-gray-500">该应用暂无可用模块入口</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var mv in Model.ModuleViews)
            {
                <details class="bg-white rounded-xl border border-gray-200 overflow-hidden" @(mv.AllUnreachable ? "" : "open")>
                    <summary class="px-5 py-4 cursor-pointer flex items-center justify-between hover:bg-gray-50 transition-colors">
                        <div>
                            <div class="font-semibold text-gray-900">@mv.Module.Name</div>
                            @if (!string.IsNullOrEmpty(mv.Module.Description))
                            {
                                <div class="text-xs text-gray-500 mt-0.5">@mv.Module.Description</div>
                            }
                        </div>
                        <div class="flex items-center gap-2 text-xs text-gray-500">
                            @if (mv.UnreachableCount > 0)
                            {
                                <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-700">@mv.UnreachableCount 项不可达</span>
                            }
                            <span>@mv.Endpoints.Count 个入口</span>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </summary>
                    <div class="border-t border-gray-100 divide-y divide-gray-50">
                        @foreach (var ep in mv.Endpoints)
                        {
                            <div class="px-5 py-3 flex items-center justify-between gap-4">
                                <div class="min-w-0">
                                    <div class="text-sm font-medium text-gray-800">@ep.Resolved.Endpoint.DisplayName</div>
                                    @if (ep.Resolved.IsReachable)
                                    {
                                        <div class="text-xs text-gray-500 truncate">@ep.Resolved.DisplayText</div>
                                    }
                                    else
                                    {
                                        <div class="text-xs text-gray-400">当前网络不可达</div>
                                    }
                                </div>
                                <div class="shrink-0">
                                    @if (ep.Resolved.IsClickable && ep.Resolved.Url is not null)
                                    {
                                        <a href="@ep.Resolved.Url"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="inline-flex items-center gap-1 text-sm text-blue-600 hover:text-blue-800 px-3 py-1.5 rounded-md hover:bg-blue-50">
                                            打开
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                            </svg>
                                        </a>
                                    }
                                    else if (ep.Resolved.IsReachable)
                                    {
                                        <span class="text-xs px-2 py-1 rounded bg-gray-100 text-gray-600 font-mono">@ep.Resolved.DisplayText</span>
                                    }
                                    else
                                    {
                                        <span class="text-xs px-2 py-1 rounded bg-gray-50 text-gray-400">不可达</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </details>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            var hostLinks = document.querySelectorAll('a[asp-route-host], a[href*="host="]');
            // Remember last selected host via query param host=
            var params = new URLSearchParams(window.location.search);
            var host = params.get('host');
            if (host) {
                try { localStorage.setItem('appportal.activeHost', host); } catch (e) { }
            }
        })();
    </script>
}